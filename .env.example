# TW ERP — environment template (spec §3)
#
# This file IS COMMITTED. It documents which variables exist; it must never hold
# a real value. Copy it to .env.local (gitignored) and fill that in instead.

# ─────────────────────────────────────────────────────────────
# Supabase — required
# Project Settings → API in the Supabase dashboard
# ─────────────────────────────────────────────────────────────

# Safe to expose to the browser. Newer projects issue this as sb_publishable_…;
# older ones as a JWT labelled "anon". Either works.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# SERVER ONLY. Bypasses Row Level Security — never prefix with NEXT_PUBLIC_,
# never import into a client component (spec §47). Anyone holding this key can
# read and write every tenant's data, so it does not belong in this file.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ─────────────────────────────────────────────────────────────
# Direct Postgres connection — optional
# Only needed for migration tooling and future transactional write paths.
# Project Settings → Database → Connection string (use the pooled URI on Railway).
# ─────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:password@db.your-project-ref.supabase.co:5432/postgres

# ─────────────────────────────────────────────────────────────
# Application
# ─────────────────────────────────────────────────────────────

# Public origin of the deployment. Used for auth redirect callbacks.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# 32+ character random string used to sign application cookies.
# This is the application's own secret and has nothing to do with Supabase —
# do not paste a Supabase key here.
# Generate with: openssl rand -base64 32
APP_SECRET=replace-with-a-32-character-random-string

NODE_ENV=development

# ─────────────────────────────────────────────────────────────
# GST / E-Invoice provider (spec §40)
# ─────────────────────────────────────────────────────────────
# Leave blank and the application still works: invoices queue for filing and the
# e-invoice screen says plainly that nothing can be transmitted. Filing becomes
# available once all five are set.
#
# All-or-nothing on purpose — a half-configured provider fails mid-filing, which
# is the worst moment to discover a missing secret.
#
# Point BASE_URL at your GSP's e-invoice API root. The client authenticates
# against <BASE_URL>/auth and submits to <BASE_URL>/invoice; providers differ in
# detail, and src/server/services/gst/irp-client.ts is the only file to change.
GST_API_BASE_URL=
GST_API_USERNAME=
GST_API_PASSWORD=
GST_API_CLIENT_ID=
GST_API_CLIENT_SECRET=
# Only when filing under a GSTIN other than the dealer's own.
GST_API_GSTIN=

# ─────────────────────────────────────────────────────────────
# Storage — optional (spec §2). Defaults to the Supabase Storage bucket below.
# ─────────────────────────────────────────────────────────────
SUPABASE_STORAGE_BUCKET=tw-erp-documents
