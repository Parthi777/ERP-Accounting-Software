# production
build/
dist/

# environment — never commit secrets (spec §3)
.env
.env.local
.env.*.local
.env.production
# …and any copy of one. A backup made before an edit holds the same live keys as
# the original, and `.env.local` alone does not match `.env.local.bak`.
.env*.bak
.env*.backup
.env*.orig
*.env

